<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher settings. Edit, then run ../build-launcher.sh. -->
<resources>
    <!-- Dock apps, left to right, wrapping every dock_columns. Apps that aren't installed are skipped. -->
    <string-array name="dock_apps">
        <item>com.crunchyroll.crunchyroid</item>
        <item>com.google.android.youtube.tv</item>
        <item>com.netflix.ninja</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>com.cbs.ott</item>
        <item>com.disney.disneyplus</item>
        <item>com.wbd.stream</item>
        <item>com.apple.atve.androidtv.appletv</item>
        <item>com.ntathome</item>
        <item>com.gamesworkshop.warhammertv</item>
        <item>com.plexapp.android</item>
        <item>com.cxinventor.file.explorer</item>
    </string-array>

    <!-- Never shown as tiles. -->
    <string-array name="hidden_apps">
    </string-array>

    <integer name="dock_columns">6</integer>
    <!-- Tiles per row in the All apps grid. -->
    <integer name="columns">6</integer>
</resources>
